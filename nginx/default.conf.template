# Unknown hosts / direct IP access: behave as if nothing exists
server {
    listen 80 default_server;
    server_name _;

    return 404;
}

# Frontend
server {
    listen 80;
    server_name app.motivacredito.com app.localhost;

    root /usr/share/nginx/html;
    index index.html;

    # 403 is reported as not found
    error_page 403 =404 /__not_found;

    location = /__not_found {
        internal;
        default_type text/plain;
        return 404 "Not Found";
    }

    # Never expose hidden files
    location ~ /\. {
        return 404;
    }

    location / {
        try_files $uri $uri/index.html /index.html;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}

# Backend
server {
    listen 80;
    server_name api.motivacredito.com api.localhost;

    client_max_body_size 10m;

    # 403 (from nginx or the upstream) is reported as not found
    proxy_intercept_errors on;
    error_page 403 =404 /__not_found;

    location = /__not_found {
        internal;
        default_type text/plain;
        return 404 "Not Found";
    }

    location / {
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Appends the address nginx saw to whatever the client sent;
        # the backend reads the LAST entry (1 trusted proxy)
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

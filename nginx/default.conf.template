upstream api {
    server ${API_HOST}:${API_PORT};
}

# Unknown hosts / direct IP access
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;

    # No certificate is presented to unknown hosts
    ssl_reject_handshake on;

    return 404;
}

# Production HTTP -> HTTPS
server {
    listen 80;
    server_name app.motivacredito.com api.motivacredito.com;

    return 301 https://$host$request_uri;
}

# Production frontend
server {
    listen 443 ssl;
    http2 on;
    server_name app.motivacredito.com;

    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;

    include /etc/nginx/snippets/frontend.conf;
}

# Production backend
server {
    listen 443 ssl;
    http2 on;
    server_name api.motivacredito.com;

    ssl_certificate     /etc/ssl/cloudflare/origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;

    include /etc/nginx/snippets/api.conf;
}

# Local development (plain HTTP, no redirect)
server {
    listen 80;
    server_name app.localhost;

    include /etc/nginx/snippets/frontend.conf;
}

server {
    listen 80;
    server_name api.localhost;

    include /etc/nginx/snippets/api.conf;
}
